---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FocusCardGrid from '../components/FocusCardGrid.astro';
import Header from '../components/Header.astro';
import LatestPosts from '../components/LatestPosts.astro';
import { CONTACT_EMAIL, SITE_DESCRIPTION, SITE_OWNER, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const focusCards = [
	{
		title: 'Scalable systems',
		copy: 'At Appliscale, we build systems that handle extreme scale—millions of users and billions of events.',
		points: [
			'Systems serving 4+ million concurrent users',
			'Processing 400+ million daily events',
			'Millisecond response times at volume',
		],
	},
	{
		title: 'Digital engineering',
		copy: 'Full-service consulting, development, and scaling for enterprise-grade applications.',
		points: ['Cloud expertise (AWS, capacity planning, cost optimization)', 'Custom development and systems architecture', 'Lean and Agile methodologies'],
	},
	{
		title: 'Global delivery',
		copy: '80+ specialists across Poland and Ireland delivering mission-critical solutions.',
		points: ['10+ years of proven delivery', '45+ projects successfully delivered', 'Partners: AWS, Databricks, Datadog'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 2rem 0 3rem;
			}
			.hero .eyebrow {
				margin-bottom: 0.5rem;
			}
			.lede {
				font-size: 1.25rem;
				max-width: 46ch;
			}
			.hero-actions {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin: 1.5rem 0 0;
			}
			.hero-actions a {
				border-radius: 999px;
				padding: 0.65rem 1.8rem;
				text-decoration: none;
				font-weight: 600;
			}
			.button {
				background: var(--accent);
				color: white;
			}
			.button:hover {
				background: var(--accent-dark);
			}
			.ghost {
				border: 2px solid var(--accent);
				color: var(--accent);
			}
			.hero-meta {
				list-style: none;
				display: flex;
				gap: 1.5rem;
				padding: 0;
				margin: 2rem 0 0;
				flex-wrap: wrap;
			}
			.hero-meta span {
				display: block;
				text-transform: uppercase;
				font-size: 0.75rem;
				letter-spacing: 0.2em;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.hero-actions {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">COO at Appliscale</p>
				<h1>Hi, I'm {SITE_OWNER}. I help companies build systems that scale.</h1>
				<p class="lede">{SITE_DESCRIPTION}</p>
				<p>
					As COO at <a href="https://appliscale.io">Appliscale</a>, I lead a team of 80+ engineers delivering scalable, high-performance systems for enterprise clients. Previously Chief of Staff at AOL Platforms, I bring deep experience in AdTech, distributed teams, and operational excellence.
				</p>
				<div class="hero-actions">
					<a class="button" href="https://appliscale.io">Visit Appliscale</a>
					<a class="ghost" href="/about">About me</a>
				</div>
				<ul class="hero-meta">
					<li>
						<span>Location</span>
						Wexford, Ireland
					</li>
					<li>
						<span>Company</span>
						Appliscale
					</li>
					<li>
						<span>Focus</span>
						Scalable systems, engineering culture
					</li>
				</ul>
			</section>

			<FocusCardGrid cards={focusCards} />

			<LatestPosts posts={posts} />
		</main>
		<Footer />
	</body>
</html>
