---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FocusCardGrid from '../components/FocusCardGrid.astro';
import Header from '../components/Header.astro';
import LatestPosts from '../components/LatestPosts.astro';
import { CONTACT_EMAIL, SITE_DESCRIPTION, SITE_OWNER, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const focusCards = [
	{
		title: 'Engineering leadership',
		copy: 'Building and scaling distributed engineering teams across multiple time zones and cultures.',
		points: [
			'Managing globally distributed teams (Dublin, Frankfurt, Paris, Boston, SF)',
			'Overseeing multi-million dollar contractor budgets',
			'Technical strategy and roadmap development',
		],
	},
	{
		title: 'AdTech expertise',
		copy: 'Deep experience in advertising technology platforms, partnerships, and industry dynamics.',
		points: ['Platform operations and optimization', 'Industry partnerships (LiveRamp, Index Platform)', 'Data-driven decision making'],
	},
	{
		title: 'Strategy & innovation',
		copy: 'Bridging technical execution with business strategy to drive meaningful outcomes.',
		points: ['Diploma in Strategy & Innovation (UCC)', 'Chief of Staff experience', 'Process improvement and operational excellence'],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 2rem 0 3rem;
			}
			.hero .eyebrow {
				margin-bottom: 0.5rem;
			}
			.lede {
				font-size: 1.25rem;
				max-width: 46ch;
			}
			.hero-actions {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
				margin: 1.5rem 0 0;
			}
			.hero-actions a {
				border-radius: 999px;
				padding: 0.65rem 1.8rem;
				text-decoration: none;
				font-weight: 600;
			}
			.button {
				background: var(--accent);
				color: white;
			}
			.button:hover {
				background: var(--accent-dark);
			}
			.ghost {
				border: 2px solid var(--accent);
				color: var(--accent);
			}
			.hero-meta {
				list-style: none;
				display: flex;
				gap: 1.5rem;
				padding: 0;
				margin: 2rem 0 0;
				flex-wrap: wrap;
			}
			.hero-meta span {
				display: block;
				text-transform: uppercase;
				font-size: 0.75rem;
				letter-spacing: 0.2em;
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.hero-actions {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">AdTech leader and engineering manager</p>
				<h1>Hi, I'm {SITE_OWNER}. I build and lead high-performing distributed teams.</h1>
				<p class="lede">{SITE_DESCRIPTION}</p>
				<p>
					With nearly a decade of experience at AOL Platforms—most recently as Chief of Staff—I've managed globally distributed engineering teams across Dublin, Frankfurt, Paris, Boston, and San Francisco. I'm passionate about AdTech, AI, and building systems that scale.
				</p>
				<div class="hero-actions">
					<a class="button" href={`mailto:${CONTACT_EMAIL}`}>Get in touch</a>
					<a class="ghost" href="/about">About me</a>
				</div>
				<ul class="hero-meta">
					<li>
						<span>Location</span>
						Wexford, Ireland
					</li>
					<li>
						<span>Background</span>
						9+ years in AdTech
					</li>
					<li>
						<span>Focus</span>
						Engineering leadership, AI, AdTech
					</li>
				</ul>
			</section>

			<FocusCardGrid cards={focusCards} />

			<LatestPosts posts={posts} />
		</main>
		<Footer />
	</body>
</html>
